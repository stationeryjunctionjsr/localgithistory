PORT=8000

# Sentry error tracking (leave empty to disable)
SENTRY_DSN=
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Security Settings
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
# Include every browser origin you use (scheme + host + port). 127.0.0.1 ≠ localhost.
# Example LAN dev: http://192.168.1.10:3000,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
ENVIRONMENT=development

# Set to true during scheduled upgrades (blocks API except health & maintenance status)
MAINTENANCE_MODE=false

# MySQL Database Connection
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@HOST/dbname

# Oracle Object Storage
OCI_BUCKET_NAME=sj-prod-assets
OCI_NAMESPACE=axiekhoevpfn
OCI_REGION=ap-hyderabad-1
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
OCI_PAR_EXPIRY_SECONDS=3600
