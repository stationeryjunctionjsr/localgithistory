# Must match where the FastAPI app listens (see backend PORT, default 8000).
# If you open the site as http://192.168.x.x:3000, use that host for the API too
# and add the same origin to backend ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional: show maintenance screen when the API is unreachable during a frontend-only deploy
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ── Tracking (consent-gated) ───────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# ── Google Ads (global site tag – injected via GTM or directly) ───────────
# Set these in GTM variables instead of here when possible.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# ── Meta / Facebook Pixel ─────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXXX

# ── Misc ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MSG91_WIDGET_ID=
NEXT_PUBLIC_MSG91_TOKEN_AUTH=
